{
	"name": "pdfjs-vue3",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.13.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ady133t/pdfjs-vue3.git"
	},
	"homepage": "https://github.com/ady133t/pdfjs-vue3#readme",
	"bugs": {
		"url": "https://github.com/ady133t/pdfjs-vue3/issues"
	},
	"scripts": {
		"predev": "node scripts/copy-pdfjs-assets.mjs",
		"dev": "node server",
		"prebuild": "node scripts/copy-pdfjs-assets.mjs",
		"build": "npm run build:client && npm run build:server",
		"build:client": "vite build --ssrManifest --outDir dist/client",
		"build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
		"preview": "cross-env NODE_ENV=production node server",
		"typecheck": "vue-tsc --noEmit"
	},
	"dependencies": {
		"compression": "^1.7.4",
		"express": "^4.19.2",
		"pdfjs-dist": "6.4.299",
		"sirv": "^2.0.4",
		"vue": "^3.4.23"
	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"@types/node": "^20.12.7",
		"@vitejs/plugin-vue": "^5.0.4",
		"cross-env": "^7.0.3",
		"typescript": "^5.4.5",
		"vite": "^6.4.3",
		"vue-tsc": "^2.0.14"
	}
}
